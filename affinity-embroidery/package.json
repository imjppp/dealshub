{
  "name": "affinity-embroidery",
  "version": "0.1.0",
  "description": "Turn Affinity Studio vector artwork into machine embroidery files (pure JavaScript).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "examples": "node scripts/make-examples.mjs",
    "verify": "bash scripts/pyverify.sh",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.sdk.json",
    "fetch-types": "bash scripts/fetch-sdk-types.sh",
    "previews": "node scripts/make-previews.mjs",
    "all": "npm test && npm run build && npm run previews && npm run examples"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
